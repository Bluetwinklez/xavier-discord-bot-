# Discord Bot Yapılandırma Dosyası
# Discord Developer Portal'dan aldığınız bilgileri buraya girin:
# https://discord.com/developers/applications

DISCORD_TOKEN=BURAYA_BOT_TOKENINI_YAPISTIRIN
CLIENT_ID=BURAYA_BOT_CLIENT_ID_YAPISTIRIN

# (Opsiyonel) Eğer komutları sadece tek bir test sunucusuna anında yüklemek isterseniz:
# GUILD_ID=BURAYA_TEST_SUNUCU_ID_YAPISTIRIN

# 🧠 OpenClaw AI Yapılandırması
# Yerel OpenClaw Gateway varsayılan adresi (http://127.0.0.1:18789/v1):
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
OPENCLAW_API_KEY=
OPENCLAW_MODEL=openclaw

# 🐟 Fish Audio (Metin-Seslendirme, en iyi kalite/ses klonlama). Boş bırakılırsa /seslendir
# otomatik olarak ücretsiz Edge TTS'e (aşağıda), o da başarısız olursa Google Translate TTS'e düşer.
# https://fish.audio üzerinden alınır.
FISHAUDIO_API_KEY=

# 🗣️ Edge TTS (opsiyonel) — Microsoft'un ücretsiz, anahtarsız, kaliteli nöral Türkçe TTS motoru.
# Fish Audio anahtarı yoksa otomatik kullanılır, ekstra kurulum/anahtar gerekmez. Ses değiştirmek
# istersen: tr-TR-EmelNeural (kadın) veya tr-TR-AhmetNeural (erkek, varsayılan).
EDGE_TTS_VOICE=tr-TR-AhmetNeural

# ⚡ Cerebras (opsiyonel) — ücretsiz katmanı olan, çok hızlı ek bir AI sağlayıcı (fallback zincirine
# eklenir). https://cloud.cerebras.ai üzerinden alınır.
CEREBRAS_API_KEY=
